# Personal Access Token with "repo" + "admin:repo_hook" + "workflow"
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub repo or org URL
# For repo runner:
GITHUB_URL=https://api.github.com/repos/USERNAME/REPO

# For org-level runner:
# GITHUB_URL=https://api.github.com/orgs/ORGNAME

# Runner name
RUNNER_NAME=my-docker-runner
